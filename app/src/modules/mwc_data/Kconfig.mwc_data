menuconfig APP_MWC_DATA
	bool "MWC Data module"
	default y
	select ZBUS
	select SMF

if APP_MWC_DATA

module = APP_MWC_DATA
module-str = MWC Data
source "subsys/logging/Kconfig.template.log_config"

config APP_MWC_DATA_CSV
	bool "Format MWC data output as CSV"
	default n
	help
		When enabled, the MWC Data module sends data as a comma-separated string.
		The output contains 13 columns:
		IMEI, ping, rsrp, band, ue_mode, operator, latitude, longitude, accuracy, battery, temp, pressure, humidity.
		If battery or environmental data is not available, the corresponding
		fields will be left empty.

config APP_MWC_DATA_LATITUDE
	string "Default latitude"
	default "0.0"
	help
		Default latitude value to include in the data output.

config APP_MWC_DATA_LONGITUDE
	string "Default longitude"
	default "0.0"
	help
		Default longitude value to include in the data output.

config APP_MWC_DATA_GPS_ACCURACY
	int "GPS accuracy in meters"
	default 0
	help
		GPS accuracy in meters to include in the data output.
		A value of 0 indicates unknown accuracy.

endif # APP_MWC_DATA 